DASHSCOPE_API_KEY=
QWEN_CHAT_MODEL=qwen3.6-flash
EVAL_JUDGE_MODEL=qwen3.8-max
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Elasticsearch 可选：与本地 BM25 同属关键词检索，未部署 ES 时保持 false
ENABLE_ES=false
ES_HOST=https://localhost
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=
ES_INDEX=ai_search_insurance_chunks
ES_VERIFY_CERTS=false
# 默认启动时不重建索引，请用 scripts/index_es.py 离线构建
ES_INDEX_ON_STARTUP=false

ENABLE_EMBEDDING=true
RAG_CHUNK_STRATEGY=structured
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=6
RAG_CANDIDATE_K=20
RAG_RRF_K=60
RAG_BM25_B=0.5

# Rerank 与低置信拒答：相关度低于 RERANK_MIN_SCORE 的片段不提供给模型
ENABLE_RERANK=true
RERANK_MODEL=qwen3.7-text-rerank
RERANK_CANDIDATES=20
RERANK_MIN_SCORE=0.5
# 查询改写（多轮补全指代、口语转条款用语），默认与生成模型相同
REWRITE_MODEL=qwen3.6-flash
CHAT_HISTORY_TURNS=6

BOCHA_API_KEY=
BOCHA_API_URL=https://api.bochaai.com/v1/web-search
BOCHA_FRESHNESS=noLimit

ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
